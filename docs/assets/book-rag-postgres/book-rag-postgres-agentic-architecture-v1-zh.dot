digraph SageBookRAG {
  graph [rankdir=LR, bgcolor="#F8FAFC", pad="0.28", nodesep="0.34", ranksep="0.72", fontname="PingFang SC", label="Sage 长书 Agentic RAG 可插拔检索架构", labelloc=t, fontsize=20];
  node [shape=box, style="rounded,filled", color="#CBD5E1", fillcolor="#FFFFFF", fontname="PingFang SC", fontsize=11, margin="0.15,0.09"];
  edge [color="#64748B", penwidth=1.3, arrowsize=0.7, fontname="PingFang SC", fontsize=9];

  user [label="用户学习问题", fillcolor="#EFF6FF", color="#60A5FA"];

  subgraph cluster_truth {
    label="本地知识真相层";
    color="#10B981"; style="rounded"; fontname="PingFang SC";
    sqlite [label="SQLite Canonical\nSource / Revision / Proposal / Wiki", fillcolor="#ECFDF5", color="#34D399"];
  }

  subgraph cluster_projection {
    label="PostgreSQL Search Projection（可重建）";
    color="#3B82F6"; style="rounded"; fontname="PingFang SC";
    sparse [label="Sparse 策略接口", fillcolor="#EFF6FF", color="#60A5FA"];
    native [label="默认\nnative GIN + ts_rank_cd", fillcolor="#F0FDFA", color="#2DD4BF"];
    auto [label="auto\n探测扩展并回退", fillcolor="#FFF7ED", color="#FDBA74"];
    bm25 [label="强制实验\npg_textsearch BM25", fillcolor="#FFF7ED", color="#FB923C"];
    dense [label="Dense 策略接口\npgvector exact + 豆包 2048", fillcolor="#F5F3FF", color="#A78BFA"];
    rrf [label="RRF Fusion", fillcolor="#FFFFFF", color="#64748B"];
    reranker [label="候选后重排\n未启用的扩展插槽", style="rounded,dashed,filled", fillcolor="#F8FAFC", color="#94A3B8"];
    sparse -> native [label="默认实现"];
    sparse -> auto [label="显式实验"];
    sparse -> bm25 [label="强制实验"];
    auto -> bm25 [label="扩展可用"];
    auto -> native [label="扩展不可用"];
    native -> rrf;
    bm25 -> rrf;
    dense -> rrf;
    rrf -> reranker [style=dashed, label="后续可插入", color="#94A3B8"];
  }

  bundle [label="EvidenceBundle\n有界证据 + citation", fillcolor="#ECFDF5", color="#34D399"];
  gate [label="Sufficiency Gate\n证据充分性", shape=diamond, fillcolor="#FFF7ED", color="#FB923C"];
  answer [label="LLMWiki Answer\n最终回答", fillcolor="#ECFDF5", color="#10B981"];
  rewrite [label="缺失 Claim\n一次有界 Rewrite / 二次检索", fillcolor="#EFF6FF", color="#60A5FA"];
  abstain [label="仍不足\n诚实拒答", fillcolor="#FFF1F2", color="#FB7185"];

  user -> sqlite [label="摄取 / 学习范围"];
  sqlite -> sparse [style=dashed, label="rebuildable projection"];
  sqlite -> dense [style=dashed];
  rrf -> bundle -> gate;
  reranker -> bundle [style=dashed, label="启用后替代直连", color="#94A3B8"];
  gate -> answer [label="证据充分", color="#10B981"];
  gate -> rewrite [label="缺失事实", color="#3B82F6"];
  rewrite -> sparse [label="最多一轮", color="#3B82F6"];
  rewrite -> dense [color="#3B82F6"];
  gate -> abstain [label="无新增证据 / 预算耗尽", color="#EF4444"];

  subgraph cluster_harness {
    label="共享 Sage Harness（与检索策略解耦）";
    color="#94A3B8"; style="rounded,dashed"; fontname="PingFang SC";
    intent [label="TaskIntent"];
    context [label="TurnContextPlan"];
    dag [label="DAG / Subagent"];
    safety [label="Permission / Policy / Sandbox"];
    timeline [label="Timeline / Trace"];
    intent -> context -> dag -> safety -> timeline;
  }

  user -> intent [style=dotted, constraint=false];
  context -> bundle [style=dotted, label="上下文预算", constraint=false];
  rewrite -> dag [style=dotted, label="只读 Research children", constraint=false];
  answer -> timeline [style=dotted, constraint=false];
  abstain -> timeline [style=dotted, constraint=false];

  subgraph cluster_eval {
    label="Offline Eval 4+2（不进入用户同步链）";
    color="#A78BFA"; style="rounded,dashed"; fontname="PingFang SC";
    eval [label="Claim Coverage | Answer Correctness\nCorrect Abstention | Recovery Gain\nProvider Failure | P95", fillcolor="#F5F3FF", color="#A78BFA"];
  }

  rrf -> eval [style=dashed, color="#A78BFA", constraint=false];
  answer -> eval [style=dashed, color="#A78BFA", constraint=false];
  abstain -> eval [style=dashed, color="#A78BFA", constraint=false];
}
