{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sage",
  "version": "0.1.0",
  "identifier": "com.sage.learning",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run desktop:launcher",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    },
    "windows": [
      {
        "label": "main",
        "title": "Sage",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "devtools": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/sage-api"],
    "resources": {
      "binaries/sidecar": "sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
