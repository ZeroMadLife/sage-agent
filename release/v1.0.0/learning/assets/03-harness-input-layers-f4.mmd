%% Sage Harness 输入分层与 F4 意图信封架构图
flowchart LR
    classDef input fill:#fff7ed,stroke:#c2410c,stroke-width:2px,color:#431407
    classDef plan fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#172554
    classDef capability fill:#ecfdf5,stroke:#059669,stroke-width:2px,color:#064e3b
    classDef runtime fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#3b0764
    classDef evidence fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#450a0a
    classDef note fill:#f9fafb,stroke:#6b7280,stroke-dasharray:5 5,color:#111827

    U["用户输入\nTurn"]:::input --> A["TaskIntentAnalyzer\n确定性规则"]:::input
    A --> E["TaskIntentEnvelope\n脱敏结构 / 无 CoT"]:::input
    E --> R["Retrieval Gate\n候选来源收窄"]:::plan
    E --> TB["ToolBundleSnapshot\n本轮能力候选"]:::capability
    R --> ASM["TurnContextAssembler\n一次性组装"]:::plan
    TB --> ASM
    C["Context / Memory / RAG\n已选择引用"]:::capability --> ASM
    MCP["MCP Manager\nconfig revision + scoped session"]:::capability --> TB
    SK["Skill Registry\nprecedence + activation + allowlist"]:::capability --> TB
    ASM --> P["TurnContextPlan\n不可变 hash / scope / budget"]:::plan
    P --> S["TurnPlanStore\n持久化并校验"]:::plan
    S --> F["ModelContextFrameFactory\nPlan binding 校验"]:::runtime
    F --> G["Graph / Model\nTool loop"]:::runtime
    G --> CP["Checkpoint\n恢复绑定"]:::evidence
    CP -.->|"Resume：只读冻结 Plan\n不重新分析意图"| S

    F --> L1["Static Policy\n服务端硬规则"]:::runtime
    F --> L2["Dynamic Authority\nscope / budget / sandbox"]:::runtime
    F --> L3["Untrusted Context Data\nTranscript / Memory / RAG / MCP 描述"]:::runtime
    L1 --> G
    L2 --> G
    L3 --> G

    N1["不授予 Permission / Policy / Approval / Sandbox 权限"]:::note -.-> E
    N2["Receipt 只记录 hash、计数和 mismatch code"]:::note -.-> P
